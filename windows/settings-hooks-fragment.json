{
  "hooks": {
    "Notification": [
      {
        "matcher": "agent_needs_input|elicitation_dialog|elicitation_url_dialog|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          { "type": "command", "command": "powershell -ExecutionPolicy Bypass -File C:/Users/<USERNAME>/.claude/hooks/notify-cb-88a85f67-1b7d-44ad-b9b3-728d218952bc.ps1" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -ExecutionPolicy Bypass -File C:/Users/<USERNAME>/.claude/hooks/notify-cb-88a85f67-1b7d-44ad-b9b3-728d218952bc.ps1" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -ExecutionPolicy Bypass -File C:/Users/<USERNAME>/.claude/hooks/start-cb-88a85f67-1b7d-44ad-b9b3-728d218952bc.ps1" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -ExecutionPolicy Bypass -File C:/Users/<USERNAME>/.claude/hooks/stop-cb-88a85f67-1b7d-44ad-b9b3-728d218952bc.ps1" }
        ]
      }
    ]
  }
}
