{
  "hooks": {
    "Notification": [
      {
        "matcher": "agent_needs_input|elicitation_dialog|elicitation_url_dialog|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          { "type": "command", "command": "powershell -ExecutionPolicy Bypass -File C:/Users/<USERNAME>/.claude/hooks/notify.ps1" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -ExecutionPolicy Bypass -File C:/Users/<USERNAME>/.claude/hooks/notify.ps1" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -ExecutionPolicy Bypass -File C:/Users/<USERNAME>/.claude/hooks/start.ps1" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "powershell -ExecutionPolicy Bypass -File C:/Users/<USERNAME>/.claude/hooks/stop.ps1" }
        ]
      }
    ]
  }
}
