{
  "description": "claude-beeps: needs-input chime (Notification/PermissionRequest) and duration-tiered finish sounds (UserPromptSubmit/Stop pair). Exec form - no shell tokenization, so paths with spaces are safe. Windows only; the scripts exit 0 quietly elsewhere.",
  "hooks": {
    "Notification": [
      {
        "matcher": "agent_needs_input|elicitation_dialog|elicitation_url_dialog|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/windows/notify-cb-88a85f67-1b7d-44ad-b9b3-728d218952bc.ps1"]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/windows/notify-cb-88a85f67-1b7d-44ad-b9b3-728d218952bc.ps1"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/windows/start-cb-88a85f67-1b7d-44ad-b9b3-728d218952bc.ps1"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/windows/stop-cb-88a85f67-1b7d-44ad-b9b3-728d218952bc.ps1"]
          }
        ]
      }
    ]
  }
}
